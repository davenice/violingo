# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# safe to commit: fake emulator values, the fill-in template, and the
# production web config (Firebase web config is public by design)
!.env.emulator
!.env.local.example
!.env.production

# vercel
.vercel

# firebase
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/
functions/node_modules/
functions/dist/
pubsub-debug.log

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e artifacts
.e2e/
