rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // parents/{parentUid} — doc ID is the owning Firebase Auth uid.
    match /parents/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // children/{childId} — parentId field ties the child back to its owning account.
    // No separate child credential exists (see plan: single shared-device account,
    // child/parent mode is an app-level PIN gate, not a Firestore permission boundary).
    match /children/{childId} {
      allow read, update, delete: if request.auth != null &&
        request.auth.uid == resource.data.parentId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.parentId;
    }

    // practiceLog and sidequests subcollections inherit access from the parent child doc.
    match /children/{childId}/{document=**} {
      allow read, write: if request.auth != null &&
        request.auth.uid ==
          get(/databases/$(database)/documents/children/$(childId)).data.parentId;
    }

    // signInCodes/{codeHash} — device-handoff codes minted by the
    // createSignInCode/redeemSignInCode Cloud Functions (see functions/src/signInCode.ts).
    // Admin SDK only; no client access, not even to the requesting user's own codes.
    match /signInCodes/{codeHash} {
      allow read, write: if false;
    }

    // signInAttempts/{emailHash} — per-email failed-redemption counters that
    // cap brute-forcing of the 6-digit code (see functions/src/signInCode.ts).
    // Admin SDK only.
    match /signInAttempts/{emailHash} {
      allow read, write: if false;
    }
  }
}
